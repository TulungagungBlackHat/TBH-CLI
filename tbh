import socket, requests, argparse, sys, urllib.parse, re

BANNER = """\033[91m╔════════════════════════════════════╗
\033[91m║ \033[97mTBH-CLI v1.5 \033[91m- Bug Bounty 12 Tools  \033[91m║
\033[91m║ \033[90mTulungagung Black Hat | uchil404 \033[91m║
\033[91m╚════════════════════════════════════╝\033[0m"""

def scan_headers(url):
    try:
        r=requests.get(url,timeout=5,headers={'User-Agent':'TBH-CLI/1.5'})
        missing=[h for h in ['Content-Security-Policy','Strict-Transport-Security'] if h not in r.headers]
        if missing: print(f"  \033[93m[!] Missing: {missing}\033[0m")
        else: print(f"  \033[92m[✓] Headers OK\033[0m")
    except: print(f"  \033[91m[-] Headers error\033[0m")

def scan_ports(ip):
    for p in [80,443,8080]:
        s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.settimeout(1)
        print(f"  {'\033[92mOPEN' if s.connect_ex((ip,p))==0 else '\033[90mCLOSED'} {p}\033[0m")
        s.close()

def scan_subs(domain):
    for sub in ["www","api","admin","test"]:
        host=f"{sub}.{domain}"
        try: ip=socket.gethostbyname(host); print(f"  \033[92m[FOUND] {host} -> {ip}\033[0m")
        except: print(f"  \033[90m[NOT] {host}\033[0m")

def scan_dirs(url):
    for path in ["admin",".env",".git"]:
        full=f"{url.rstrip('/')}/{path}"
        try:
            r=requests.get(full,timeout=3,allow_redirects=False)
            if r.status_code in [200,403]: print(f"  \033[91m[FOUND] {r.status_code} {full}\033[0m")
            else: print(f"  \033[90m[NOT] {r.status_code} {path}\033[0m")
        except: print(f"  [-] {path} error")

def scan_xss(url):
    payload="<svg/onload=alert(1)>"
    test_url=f"{url}?q={urllib.parse.quote(payload)}"
    try:
        r=requests.get(test_url,timeout=5)
        if payload in r.text: print(f"  \033[91m[!] XSS Reflected\033[0m")
        else: print(f"  \033[92m[✓] XSS tidak reflected\033[0m")
    except: print(f"  [-] XSS error")

def scan_redirect(url):
    payload="https://evil.com"
    test_url=f"{url}?redirect={payload}"
    try:
        r=requests.get(test_url,timeout=5,allow_redirects=False)
        if payload in r.headers.get('Location',''): print(f"  \033[91m[!] OpenRedirect Vulnerable\033[0m")
        else: print(f"  \033[92m[✓] OpenRedirect tidak vulnerable\033[0m")
    except: print(f"  [-] Redirect error")

def scan_cors(url):
    try:
        r=requests.get(url,timeout=5,headers={'Origin':'https://evil.com'})
        acao=r.headers.get('Access-Control-Allow-Origin','')
        if acao=="https://evil.com" or acao=="*": print(f"  \033[91m[!] CORS Misconfig: {acao}\033[0m")
        else: print(f"  \033[92m[✓] CORS OK\033[0m")
    except: print(f"  [-] CORS error")

def scan_sqli(url):
    payload="'"
    test_url=f"{url}?id={urllib.parse.quote(payload)}"
    try:
        r=requests.get(test_url,timeout=5)
        if "sql syntax" in r.text.lower(): print(f"  \033[91m[!] SQLi Potensi\033[0m")
        else: print(f"  \033[92m[✓] SQLi tidak terdeteksi\033[0m")
    except: print(f"  [-] SQLi error")

def scan_ssrf(url):
    payload="http://169.254.169.254/latest/meta-data/"
    test_url=f"{url}?url={urllib.parse.quote(payload)}"
    try:
        r=requests.get(test_url,timeout=5)
        if "meta-data" in r.text.lower(): print(f"  \033[91m[!] SSRF Potensi\033[0m")
        else: print(f"  \033[92m[✓] SSRF tidak terdeteksi\033[0m")
    except: print(f"  [-] SSRF error")

def scan_lfi(url):
    payload="../../../../etc/passwd"
    test_url=f"{url}?file={urllib.parse.quote(payload)}"
    try:
        r=requests.get(test_url,timeout=5)
        if "root:" in r.text: print(f"  \033[91m[!] LFI Vulnerable\033[0m")
        else: print(f"  \033[92m[✓] LFI tidak terdeteksi\033[0m")
    except: print(f"  [-] LFI error")

def scan_ssti(url):
    payload="{{7*7}}"
    test_url=f"{url}?q={urllib.parse.quote(payload)}"
    try:
        r=requests.get(test_url,timeout=5)
        if "49" in r.text: print(f"  \033[91m[!] SSTI Potensi (49)\033[0m")
        else: print(f"  \033[92m[✓] SSTI tidak terdeteksi\033[0m")
    except: print(f"  [-] SSTI error")

def scan_idor(url):
    # Simple IDOR hint
    if "id=" in url:
        test_url=url.replace("id=", "id=1")
        try:
            r=requests.get(test_url,timeout=5)
            if r.status_code==200: print(f"  \033[93m[?] IDOR cek manual: {test_url} [{r.status_code}] - ganti ID cek data lain\033[0m")
            else: print(f"  \033[92m[✓] IDOR tidak terdeteksi\033[0m")
        except: print(f"  [-] IDOR error")
    else: print(f"  \033[90m[-] IDOR butuh ?id= di URL, skip\033[0m")

def bugbounty_menu(url):
    domain=urllib.parse.urlparse(url if url.startswith("http") else "https://"+url).netloc
    try: ip=socket.gethostbyname(domain)
    except: print("[!] Cannot resolve"); return
    print(f"\n\033[96m[*] Bug Bounty 12 Tools: {domain} ({ip})\033[0m")
    print("="*50)
    print("\033[93m[1] Headers\033[0m"); scan_headers(url)
    print("\033[93m[2] Ports\033[0m"); scan_ports(ip)
    print("\033[93m[3] Subdomains\033[0m"); scan_subs(domain)
    print("\033[93m[4] Dirs\033[0m"); scan_dirs(url)
    print("\033[93m[5] XSS\033[0m"); scan_xss(url)
    print("\033[93m[6] OpenRedirect\033[0m"); scan_redirect(url)
    print("\033[93m[7] CORS\033[0m"); scan_cors(url)
    print("\033[93m[8] SQLi\033[0m"); scan_sqli(url)
    print("\033[93m[9] SSRF\033[0m"); scan_ssrf(url)
    print("\033[93m[10] LFI\033[0m"); scan_lfi(url)
    print("\033[93m[11] SSTI\033[0m"); scan_ssti(url)
    print("\033[93m[12] IDOR\033[0m"); scan_idor(url)
    print("="*50)
    print("\033[92m[✓] Bug Bounty CLI 12 Tools Selesai\033[0m")

