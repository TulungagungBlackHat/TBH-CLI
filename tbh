#!/usr/bin/env python3
# TBH-CLI - Pure CLI Version (No HTML/JSON, hanya terminal)
import socket, requests, argparse, re, ssl, urllib.parse
from datetime import datetime

BANNER = """\033[91m TBH-CLI v1.0 - Pure CLI \033[0m
\033[90mTulungagung Black Hat | uchil404\033[0m"""

def cli_scan(url):
    domain=urllib.parse.urlparse(url if url.startswith("http") else "https://"+url).netloc
    try: ip=socket.gethostbyname(domain)
    except: print(f"[!] Cannot resolve {domain}"); return
    print(f"{BANNER}\n[*] {domain} ({ip}) | {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print("-"*50)
    # Headers
    try:
        r=requests.get(url,timeout=5,headers={'User-Agent':'TBH-CLI/1.0'})
        missing=[h for h in ['Content-Security-Policy','Strict-Transport-Security'] if h not in r.headers]
        if missing: print(f"\033[93m[!] Headers Missing: {missing}\033[0m")
        else: print(f"\033[92m[✓] Headers OK\033[0m")
        print(f"    Status: {r.status_code} Server: {r.headers.get('Server','Unknown')}")
    except as e: print(f"[-] Headers error: {e}")
    # Ports
    print("-"*50)
    for p in [80,443]:
        s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.settimeout(1)
        open_ = s.connect_ex((ip,p))==0
        print(f"{'OPEN' if open_ else 'CLOSED'} {p}")
        s.close()
    print("-"*50)
    print("\033[92m[✓] CLI Scan Selesai - Pure terminal, tanpa file\033[0m")

if __name__=="__main__":
    parser=argparse.ArgumentParser(description="TBH-CLI Pure CLI")
    parser.add_argument("-u","--url",required=True,help="Target URL")
    args=parser.parse_args()
    cli_scan(args.url)
